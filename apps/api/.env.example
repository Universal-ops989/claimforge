# Copy to .env and adjust. Values match compose.yaml defaults.
CLAIMFORGE_ENVIRONMENT=development
CLAIMFORGE_DEBUG=false
CLAIMFORGE_LOG_LEVEL=INFO
CLAIMFORGE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CLAIMFORGE_DATABASE_URL=postgresql+asyncpg://claimforge:claimforge@localhost:5432/claimforge
CLAIMFORGE_TEST_DATABASE_URL=postgresql+asyncpg://claimforge:claimforge@localhost:5432/claimforge_test
CLAIMFORGE_SMTP_HOST=localhost
CLAIMFORGE_SMTP_PORT=1025
CLAIMFORGE_S3_ENDPOINT_URL=http://localhost:8333
CLAIMFORGE_S3_ACCESS_KEY=local
CLAIMFORGE_S3_SECRET_KEY=local
CLAIMFORGE_S3_BUCKET=claimforge-media
