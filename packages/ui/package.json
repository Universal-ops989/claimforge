{
  "name": "@claimforge/ui",
  "version": "0.1.0",
  "private": true,
  "description": "ClaimForge design system: accessible, themeable React components",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form.js"
    },
    "./styles.css": "./dist/claimforge-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "clean": "rimraf dist coverage",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --quiet",
    "test-storybook": "vitest run --project storybook"
  },
  "devDependencies": {
    "@claimforge/eslint-config": "workspace:^",
    "@claimforge/tsconfig": "workspace:^",
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-docs": "^10",
    "@storybook/addon-vitest": "^10",
    "@storybook/react-vite": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "^10",
    "jsdom": "^31",
    "playwright": "^1",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "rimraf": "^6.1.4",
    "storybook": "^10",
    "typescript": "~5.9.3",
    "vite": "^8",
    "vitest": "^5"
  },
  "dependencies": {
    "@tanstack/react-table": "^8",
    "clsx": "^2",
    "date-fns": "^4",
    "lucide-react": "^1",
    "radix-ui": "^1",
    "react-day-picker": "^9"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.50"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  }
}
